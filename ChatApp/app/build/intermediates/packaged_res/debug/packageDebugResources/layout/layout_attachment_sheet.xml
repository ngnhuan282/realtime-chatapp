<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout style="@style/AttachmentItemStyle">
            <ImageView
                android:id="@+id/btnAttachImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_icon_image"
                android:padding="16dp"
                app:tint="#FFFFFF" />
            <TextView style="@style/AttachmentTextStyle" android:text="Image" />
        </LinearLayout>

        <LinearLayout style="@style/AttachmentItemStyle">
            <ImageView
                android:id="@+id/btnAttachVideo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_icon_video"
                android:padding="16dp"
                android:src="@drawable/ic_video"
                app:tint="#FFFFFF" />
            <TextView style="@style/AttachmentTextStyle" android:text="Video" />
        </LinearLayout>

        <LinearLayout style="@style/AttachmentItemStyle">
            <ImageView
                android:id="@+id/btnAttachLocation"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_icon_location"
                android:padding="16dp"
                android:src="@drawable/ic_location"
                app:tint="#FFFFFF" />
            <TextView style="@style/AttachmentTextStyle" android:text="Location" />
        </LinearLayout>

        <LinearLayout style="@style/AttachmentItemStyle">
            <ImageView
                android:id="@+id/btnAttachEmoji"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_icon_emoji"
                android:padding="16dp"
                android:src="@drawable/ic_emoji"
                app:tint="#FFFFFF" />
            <TextView style="@style/AttachmentTextStyle" android:text="Emoji" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>